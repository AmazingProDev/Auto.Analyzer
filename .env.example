# Existing backend/storage settings
PORT=8000
OPTIM_BACKEND_URL=http://localhost:8000
OPTIM_UPLOAD_DIR=/tmp/optim_uploads

# Optional existing database settings
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=your-token-here

# Local LM Studio / Gemma 4 integration
OPTIM_LM_STUDIO_BASE_URL=http://localhost:1234/v1
OPTIM_LM_STUDIO_MODEL=gemma-4-e4b-it
OPTIM_LOCAL_AI_TIMEOUT_SEC=120
OPTIM_LOCAL_AI_MAX_RETRIES=2
OPTIM_LOCAL_AI_MAX_UPLOAD_MB=25
OPTIM_LOCAL_AI_CHUNK_LINES=160
OPTIM_LOCAL_AI_CHUNK_OVERLAP=30
OPTIM_LOCAL_AI_MAX_IDENTIFIER_VALUES=12
OPTIM_LOCAL_AI_KEEP_UPLOADS=0
OPTIM_LOCAL_AI_UPLOAD_DIR=/tmp/optim_uploads/local_ai_uploads
